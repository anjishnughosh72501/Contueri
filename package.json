{
  "name": "contueri",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "shared",
    "worker",
    "web"
  ],
  "scripts": {
    "dev": "concurrently -n \"worker,web\" -c \"blue,green\" \"npm run dev:worker\" \"npm run dev:web\"",
    "dev:worker": "npm --workspace=worker run dev",
    "dev:web": "npm --workspace=web run dev",
    "build:shared": "npm --workspace=shared run build",
    "build:worker": "npm --workspace=worker run build",
    "build:web": "npm --workspace=web run build",
    "build": "npm run build:shared && npm run build:worker && npm run build:web",
    "test:e2e": "node scripts/tests/runner.mjs"
  },
  "allowScripts": {
    "esbuild@0.21.5": true,
    "esbuild@0.28.2": true,
    "workerd@1.20261019.1": true
  },
  "devDependencies": {
    "@types/ws": "^8.18.2",
    "concurrently": "^10.0.6",
    "ws": "^8.22.0"
  }
}
